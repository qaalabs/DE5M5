<style>
/* Deliberately does NOT assign a separate named @page type here --
   that forced a spurious blank leading page in testing (a known print
   engine quirk when the page type changes on the very first element).
   Instead this sits on the same shared page as the rest of the
   document (print-site-material.css: @page { margin: 4em 1.5em; }) and
   subtracts that reserved top+bottom margin from 100vh in the same
   `em` unit, so it cancels out regardless of root font size. Trade-off:
   the stripe/logo sit inside that margin rather than bleeding to the
   true paper edge. */
#print-site-cover-page {
    position: relative;
    height: calc(100vh - 8em);
    max-height: calc(100vh - 8em);
    overflow: hidden;
    text-align: left;
    page-break-after: always;
}
#print-site-cover-page .cover-stripe {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 80px;
    object-fit: cover;
}
#print-site-cover-page .cover-header {
    margin-left: 120px;
    padding-top: 15%;
}
#print-site-cover-page .cover-header h1 {
    font-size: 2.2em;
    margin: 0;
}
#print-site-cover-page .cover-logo {
    position: absolute;
    bottom: 40px;
    right: 40px;
    width: 200px;
}
</style>

<img class="cover-stripe" src="data:image/png;base64," alt="">

<div class="cover-header">
    <h1>{{ config.site_name }}</h1>
</div>

<img class="cover-logo" src="data:image/png;base64," alt="QA - Learn. To Change.">

